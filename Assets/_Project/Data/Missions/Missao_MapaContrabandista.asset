  m_Script: {fileID: 11500000, guid: a93de303936cbe94da1706226d9b9d52, type: 3}
  m_Name: Missao_MapaContrabandista
  m_EditorClassIdentifier: Pirates.Missions::Pirates.Missions.MissionDefinition
  missionId: mapa_contrabandista
  title: O mapa do contrabandista
  giver: Rato Velho
  description: "Um contrabandista b\xEAbado perdeu este mapa no cais: um X na praia noroeste da Ilha Oeste, junto de um bote virado. Os comparsas dele est\xE3o logo ali..."
  type: 3
  count: 1
  targetId: tesouro_oeste_2
  targetName: Ilha Oeste
  delivery: []
  rewards:
  - item: {fileID: 11400000, guid: f03ee975a2fb08742a0d154ca182578b, type: 2}
    amount: 50
  objectiveText: 
  doneText: 
  repeatable: 1
  cooldownSeconds: 600
  requiredRank: 1
  fameReward: 15
  givenByNpc: 1
  offerLines:
  - "Shh! Fale baixo, capit\xE3o. As paredes deste porto t\xEAm ouvidos, e os ouvidos t\xEAm facas."
  - "Um contrabandista b\xEAbado deixou cair este mapa no cais. Eu peguei. Ningu\xE9m viu. Certo?"
  - "O X fica na praia noroeste da Ilha Oeste, junto de um bote virado. O problema: os comparsas dele est\xE3o logo ali, no esconderijo."
  - "Eu sou r\xE1pido, mas n\xE3o sou valente. Voc\xEA parece as duas coisas. Cave antes que eles percebam."
  acceptLine: "\xD3timo, \xF3timo. E se perguntarem, voc\xEA nunca me viu."
  declineLine: "Tudo bem, tudo bem. Esque\xE7a que eu existo. Todo mundo esquece."
  waitingLine: "E o bote virado? Praia noroeste da Ilha Oeste. R\xE1pido, antes que o dono volte s\xF3brio."
  doneLines:
  - "Voc\xEA achou! E ainda est\xE1 vivo. Melhor ainda."
  - "Aqui, a sua parte. E lembre: n\xE3o fui eu quem te deu aquele mapa."
  restingLine: "Sem mapas agora. Mas os b\xEAbados do cais sempre perdem alguma coisa..."
