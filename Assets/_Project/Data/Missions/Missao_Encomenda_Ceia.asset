  m_Name: Missao_Encomenda_Ceia
  m_EditorClassIdentifier: Pirates.Missions::Pirates.Missions.MissionDefinition
  missionId: encomenda_ceia
  title: A ceia dos pescadores
  giver: Iara
  description: Os pescadores velhos ceiam juntos no cais aos domingos, e a minha rede rasgou. Me traga cavala e arenque.
  type: 2
  count: 1
  targetId: 
  targetName: 
  delivery:
  - item: {fileID: 11400000, guid: 5f5fdb6cee1fa0043b6cebb499aae5e1, type: 2}
    amount: 6
  - item: {fileID: 11400000, guid: 1300e1abe9e29414ba6e2aebc02e7be8, type: 2}
