  requiredRank: 0
  fameReward: 6
  givenByNpc: 1
  offerLines:
  - "O botic\xE1rio me pediu peixe esquisito: baiacu, pelo veneno, e ouri\xE7o, pelos espinhos."
  - "Dois de cada, capit\xE3o. Cuidado com o baiacu: n\xE3o coma, por nada."
  acceptLine: "Combinado. E n\xE3o me apare\xE7a inchado!"
  declineLine: "Tudo bem, capit\xE3o. Tenho outras encomendas, se quiser."
  waitingLine: "Dois baiacus e dois ouri\xE7os para o botic\xE1rio, capit\xE3o."
  doneLines:
  - "Veneno e espinho, tudo certo. O botic\xE1rio vai ficar feliz."
  - Tome o pagamento dele, e o meu obrigado.
  restingLine: "O botic\xE1rio tem rem\xE9dio para a vila inteira. Volte depois."
