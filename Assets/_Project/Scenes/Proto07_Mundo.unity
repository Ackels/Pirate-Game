MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 940312298}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07fe360a92dcfb740a653961e5614d0d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Pirates.UI::Pirates.UI.PrologueHUD
  frames:
  - {fileID: 2800000, guid: 5adf517626cba9c46a04b0c93ac1a966, type: 3}
  - {fileID: 2800000, guid: 82b43a19bfe835e4480fa467bc9e36f9, type: 3}
  - {fileID: 2800000, guid: af9b798bed5575f498341c402b27242f, type: 3}
  - {fileID: 2800000, guid: b5f59b57c11793346b01078531c29268, type: 3}
  - {fileID: 2800000, guid: fa92a4a219f89b34fa926267523fb93d, type: 3}
  - {fileID: 2800000, guid: 6fe419f36e6e8384d9ae64c03bae913b, type: 3}
  - {fileID: 2800000, guid: 0660c3337ec414747b24acd5ddf2f464, type: 3}
  - {fileID: 2800000, guid: 995c803bcfedc60468b76b2ee6b4648c, type: 3}
  - {fileID: 2800000, guid: bc0d3c464249aca4eb2ab3b0b3edf505, type: 3}
  lines:
  - "Dizem que no fundo do Mar de Prata dorme a Coroa de Prata, a nau capit\xE2nia da frota mais rica que j\xE1 cruzou estas \xE1guas."
  - "H\xE1 cem anos, capit\xE3es morrem procurando por ela."
  - "{nome} chegou mais perto que todos. Mas n\xE3o chegou sozinho."
  - "L\xE1zaro Negro esperou o mapa ficar pronto... e ent\xE3o mostrou quem era."
  - "Ficou com o mapa. Ficou com a tripula\xE7\xE3o. Ficou com tudo."
  - "Deixou {nome} para o mar. O mar n\xE3o quis."
  - "Tr\xEAs dias depois, as ondas o levaram a Porto Alento: uma vila esquecida que paga tributo a L\xE1zaro."
  - "L\xE1, um velho almirante lhe ofereceu um barco remendado, um cais quebrado... e uma chance."
  - Agora, o Mar de Prata vai aprender o seu nome.
  gameTitle: A Coroa de Prata
  minFrameSeconds: 6.5
  secondsPerLetter: 0.055
  titleExtraSeconds: 2.5
  fadeSeconds: 0.9
